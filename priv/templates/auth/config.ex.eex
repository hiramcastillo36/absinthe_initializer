defmodule <%= @app_module %>.Auth.Config do
  @moduledoc """
  Runtime configuration for `<%= @app_module %>` GraphQL authentication.

  Configure in `config/config.exs` (and override per environment in `config/runtime.exs`):

      config :<%= @app_name %>, <%= @app_module %>.Auth,
        transport: <%= inspect(@auth_transport) %>,
        cookie_name: "_<%= @app_name %>_session",
        cookie_opts: [http_only: true, secure: true, same_site: "Lax", max_age: 604_800],
        session_ttl_days: 7,
        cache: <%= inspect(@cache) %>,
        cache_ttl_seconds: 300,
        rate_limit: [enabled: <%= @rate_limit %>, max_requests: 10, window_seconds: 60]
  """

  @app :<%= @app_name %>
  @config_key <%= @app_module %>.Auth

  def all do
    Application.get_env(@app, @config_key, [])
  end

  @doc "Supported values: `:bearer`, `:cookie`, `:both`."
  def transport do
    Keyword.get(all(), :transport, <%= inspect(@auth_transport) %>)
  end

  def cookies_enabled? do
    transport() in [:cookie, :both]
  end

  def bearer_enabled? do
    transport() in [:bearer, :both]
  end

  def cookie_name do
    Keyword.get(all(), :cookie_name, "_<%= @app_name %>_session")
  end

  def cookie_opts do
    defaults = [
      http_only: true,
      secure: false,
      same_site: "Lax",
      max_age: session_ttl_days() * 86_400
    ]

    Keyword.merge(defaults, Keyword.get(all(), :cookie_opts, []))
  end

  def session_ttl_days do
    Keyword.get(all(), :session_ttl_days, 7)
  end

  @doc "Supported values: `:ets`, `:cachex`, `:none`, or a custom module implementing `SessionCache`."
  def cache do
    Keyword.get(all(), :cache, <%= inspect(@cache) %>)
  end

  def cache_ttl_seconds do
    Keyword.get(all(), :cache_ttl_seconds, 300)
  end

  def rate_limit_config do
    defaults = [enabled: <%= @rate_limit %>, max_requests: 10, window_seconds: 60]
    Keyword.merge(defaults, Keyword.get(all(), :rate_limit, []))
  end

  def rate_limit_enabled? do
    Keyword.get(rate_limit_config(), :enabled, <%= @rate_limit %>)
  end

  def rate_limit_max_requests do
    Keyword.get(rate_limit_config(), :max_requests, 10)
  end

  def rate_limit_window_seconds do
    Keyword.get(rate_limit_config(), :window_seconds, 60)
  end
end

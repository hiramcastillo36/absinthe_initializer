defmodule <%= @app_module %>Web.Schema.Middleware.AdminAuthentication do
  @moduledoc """
  Absinthe middleware that ensures the authenticated `current_user` has admin privileges.
  """

  @behaviour Absinthe.Middleware

  alias <%= @app_module %>.Accounts.User

  @impl Absinthe.Middleware
  def call(%{context: %{current_user: %User{is_admin: true}}} = resolution, _opts) do
    resolution
  end

  def call(%{context: %{current_user: %User{}}} = resolution, _opts) do
    Absinthe.Resolution.put_result(resolution, {:error, "Not authorized!"})
  end

  def call(resolution, _opts) do
    Absinthe.Resolution.put_result(resolution, {:error, "Please sign in first!"})
  end
end

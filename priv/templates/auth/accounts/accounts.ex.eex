defmodule <%= @app_module %>.Accounts do
  @moduledoc """
  The Accounts context with hashed session tokens and configurable session caching.
  """

  import Ecto.Query, warn: false

  alias <%= @app_module %>.Accounts.{User, UserNotifier, UserToken}
  alias <%= @app_module %>.Auth.SessionCache
  alias <%= @app_module %>.Repo

  ## Database getters

  def list_users do
    Repo.all(User)
  end

  def get_user_by_email(email) when is_binary(email) do
    Repo.get_by(User, email: email)
  end

  def get_user_by_id(id), do: Repo.get(User, id)

  def get_user_by_email_and_password(email, password)
      when is_binary(email) and is_binary(password) do
    user = Repo.get_by(User, email: email)
    if User.valid_password?(user, password), do: user
  end

  def get_user!(id), do: Repo.get!(User, id)

  ## User registration & roles

  def register_user(attrs) do
    %User{}
    |> User.registration_changeset(attrs)
    |> Repo.insert()
  end

  def update_user_role(%User{} = user, attrs) do
    with {:ok, updated_user} <- user |> User.role_changeset(attrs) |> Repo.update() do
      SessionCache.delete_user_sessions(updated_user.id)
      {:ok, updated_user}
    end
  end

  def change_user_registration(%User{} = user, attrs \\ %{}) do
    User.registration_changeset(user, attrs, hash_password: false, validate_email: false)
  end

  ## Settings

  def change_user_email(user, attrs \\ %{}) do
    User.email_changeset(user, attrs, validate_email: false)
  end

  def delete_user(%User{} = user) do
    with {:ok, deleted_user} <- Repo.delete(user) do
      SessionCache.delete_user_sessions(deleted_user.id)
      {:ok, deleted_user}
    end
  end

  def apply_user_email(user, password, attrs) do
    user
    |> User.email_changeset(attrs)
    |> User.validate_current_password(password)
    |> Ecto.Changeset.apply_action(:update)
  end

  def update_user_email(user, token) do
    context = "change:#{user.email}"

    with {:ok, query} <- UserToken.verify_change_email_token_query(token, context),
         %UserToken{sent_to: email} <- Repo.one(query),
         {:ok, _} <- Repo.transaction(user_email_multi(user, email, context)) do
      SessionCache.delete_user_sessions(user.id)
      :ok
    else
      _ -> :error
    end
  end

  defp user_email_multi(user, email, context) do
    changeset =
      user
      |> User.email_changeset(%{email: email})
      |> User.confirm_changeset()

    Ecto.Multi.new()
    |> Ecto.Multi.update(:user, changeset)
    |> Ecto.Multi.delete_all(:tokens, UserToken.by_user_and_contexts_query(user, [context]))
  end

  def deliver_user_update_email_instructions(%User{} = user, current_email, update_email_url_fun)
      when is_function(update_email_url_fun, 1) do
    {encoded_token, user_token} = UserToken.build_email_token(user, "change:#{current_email}")
    Repo.insert!(user_token)
    UserNotifier.deliver_update_email_instructions(user, update_email_url_fun.(encoded_token))
  end

  def change_user_password(user, attrs \\ %{}) do
    User.password_changeset(user, attrs, hash_password: false)
  end

  def update_user_password(user, password, attrs) do
    changeset =
      user
      |> User.password_changeset(attrs)
      |> User.validate_current_password(password)

    Ecto.Multi.new()
    |> Ecto.Multi.update(:user, changeset)
    |> Ecto.Multi.delete_all(:tokens, UserToken.by_user_and_contexts_query(user, :all))
    |> Repo.transaction()
    |> case do
      {:ok, %{user: updated_user}} ->
        SessionCache.delete_user_sessions(updated_user.id)
        {:ok, updated_user}

      {:error, :user, changeset, _} ->
        {:error, changeset}
    end
  end

  ## Session

  @doc """
  Generates an encoded session token, stores its SHA-256 hash in the database,
  and caches the session user.
  """
  def generate_user_session_token(%User{} = user) do
    {encoded_token, user_token} = UserToken.build_session_token(user)
    Repo.insert!(user_token)
    SessionCache.put(encoded_token, user)
    encoded_token
  end

  @doc """
  Gets the user for an encoded session token, rejecting malformed tokens in memory
  before checking the configured session cache or database.
  """
  def get_user_by_session_token(encoded_token) when is_binary(encoded_token) do
    with {:ok, _hashed_token} <- UserToken.hash_session_token(encoded_token) do
      case SessionCache.get(encoded_token) do
        {:ok, %User{} = user} ->
          user

        :miss ->
          with {:ok, query} <- UserToken.verify_session_token_query(encoded_token),
               %User{} = user <- Repo.one(query) do
            SessionCache.put(encoded_token, user)
            user
          else
            _ -> nil
          end
      end
    else
      :error -> nil
    end
  end

  def get_user_by_session_token(_), do: nil

  @doc """
  Revokes a single session token in the database and removes it from the cache.
  """
  def delete_user_session_token(encoded_token) when is_binary(encoded_token) do
    SessionCache.delete(encoded_token)

    with {:ok, hashed_token} <- UserToken.hash_session_token(encoded_token) do
      Repo.delete_all(UserToken.by_token_and_context_query(hashed_token, "session"))
    end

    :ok
  end

  def delete_user_session_token(_), do: :ok

  @doc """
  Revokes all active sessions for a user across all devices.
  """
  def delete_all_user_session_tokens(%User{} = user) do
    Repo.delete_all(UserToken.by_user_and_contexts_query(user, ["session"]))
    SessionCache.delete_user_sessions(user.id)
    :ok
  end

  ## Confirmation

  def deliver_user_confirmation_instructions(%User{} = user, confirmation_url_fun)
      when is_function(confirmation_url_fun, 1) do
    if user.confirmed_at do
      {:error, :already_confirmed}
    else
      {encoded_token, user_token} = UserToken.build_email_token(user, "confirm")
      Repo.insert!(user_token)
      UserNotifier.deliver_confirmation_instructions(user, confirmation_url_fun.(encoded_token))
    end
  end

  def confirm_user(token) do
    with {:ok, query} <- UserToken.verify_email_token_query(token, "confirm"),
         %User{} = user <- Repo.one(query),
         {:ok, %{user: user}} <- Repo.transaction(confirm_user_multi(user)) do
      {:ok, user}
    else
      _ -> :error
    end
  end

  defp confirm_user_multi(user) do
    Ecto.Multi.new()
    |> Ecto.Multi.update(:user, User.confirm_changeset(user))
    |> Ecto.Multi.delete_all(:tokens, UserToken.by_user_and_contexts_query(user, ["confirm"]))
  end

  ## Reset password

  def deliver_user_reset_password_instructions(%User{} = user, reset_password_url_fun)
      when is_function(reset_password_url_fun, 1) do
    {encoded_token, user_token} = UserToken.build_email_token(user, "reset_password")
    Repo.insert!(user_token)
    UserNotifier.deliver_reset_password_instructions(user, reset_password_url_fun.(encoded_token))
  end

  def get_user_by_reset_password_token(token) do
    with {:ok, query} <- UserToken.verify_email_token_query(token, "reset_password"),
         %User{} = user <- Repo.one(query) do
      user
    else
      _ -> nil
    end
  end

  def reset_user_password(user, attrs) do
    Ecto.Multi.new()
    |> Ecto.Multi.update(:user, User.password_changeset(user, attrs))
    |> Ecto.Multi.delete_all(:tokens, UserToken.by_user_and_contexts_query(user, :all))
    |> Repo.transaction()
    |> case do
      {:ok, %{user: updated_user}} ->
        SessionCache.delete_user_sessions(updated_user.id)
        {:ok, updated_user}

      {:error, :user, changeset, _} ->
        {:error, changeset}
    end
  end
end
